{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@app/shared": [
        "app/shared/src"
      ],
      "@app/shared/*": [
        "app/shared/src/*"
      ],
      "@shared/*": [
        "app/shared/src/*"
      ]
    }
  }
}
